# 필수. 비어 있으면 앱이 시작되지 않습니다. 랜덤 값으로 교체하세요.
# 생성 명령: .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 사용할 MySQL 서버의 접속 정보
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=BookBinder

# HTTPS 운영 환경에서는 true
SESSION_COOKIE_SECURE=false

# FE가 호출하는 출처(쉼표 구분, 정확히 일치하는 값만 허용, * 불가). 비우면 CORS 헤더를 붙이지 않는다.
CORS_ORIGINS=http://localhost:5173

# 도서 공급자 / 교내 소장 목록: none | fixture (fixture는 FLASK_DEBUG=1 개발 환경에서만 켜진다)
BOOK_PROVIDER=none
LIBRARY_CATALOG=none
